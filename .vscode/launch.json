{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Code",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${input:basic_dev_setup-variant}/x86/${input:application-to-debug}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }

    ],
    "inputs": [
        {
            "id": "basic_dev_setup-variant",
            "description": "What basic_dev_setup variant?",
            "type": "pickString",
            "options": [
                "variantX",
                "variantY"
            ],
            "default": "variantX"
        },
        {
            "id": "application-to-debug",
            "description": "What test application to debug?",
            "type": "pickString",
            "options": [
                "test_appl_dummy/test_app_dummy",
                "lib/uselessCmp/uselessCmp_test",
            ],
            "default": "test_appl_dummy/test_app_dummy"
        },        
    ]    
}